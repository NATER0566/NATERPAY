# NATER-PAY Enterprise Fintech Platform - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ============================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# ============================================
MONGODB_URI=MONGO_URI=mongodb+srv://naterpay01_db_user:4vcdMqNk5aqEGieq@naterpay.adiatr0.mongodb.net/?appName=Naterpay

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# PAYMENT PROVIDERS
# ============================================
# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Monnify
MONNIFY_API_KEY=MK_TEST_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONNIFY_SECRET_KEY=SECK_TEST_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONNIFY_CONTRACT_CODE=xxxxxxxxxxxxxxxx

# ============================================
# VTU PROVIDERS
# ============================================
# VTpass
VTPASS_USERNAME=your_vtpass_username
VTPASS_PASSWORD=your_vtpass_password

# VTUGate
VTUGATE_API_KEY=your_vtugate_api_key
VTUGATE_PUBLIC_KEY=your_vtugate_public_key

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@naterpay.com

# ============================================
# CLOUDINARY (Media Storage)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# SMS PROVIDER
# ============================================
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=NATERPAY

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_WALLET=false
ENABLE_LOANS=false
ENABLE_SAVINGS=false
ENABLE_ESCROW=false
ENABLE_VIRTUAL_CARDS=false
ENABLE_AGENT_BANKING=false
ENABLE_TASK_EARN=false
ENABLE_DAILY_REWARDS=false
ENABLE_SPIN_WIN=false
ENABLE_AIRTIME_CASH=false

# ============================================
# SECURITY CONFIGURATION
# ============================================
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=30
SESSION_TIMEOUT=1800
OTP_EXPIRY=300

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ============================================
# REDIS (Optional - for production scaling)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# ADMIN CONFIGURATION
# ============================================
ADMIN_EMAIL=admin@naterpay.com
ADMIN_PHONE=+2348000000000

# ============================================
# BUSINESS CONFIGURATION
# ============================================
DEFAULT_REFERRAL_BONUS=100
MIN_WITHDRAWAL=1000
MAX_WITHDRAWAL=500000
TRANSACTION_FEE_PERCENTAGE=1.5

# ============================================
# CRON JOBS
# ============================================
CRON_RECONCILIATION=*/30 * * * *
CRON_BACKUP=0 2 * * *
CRON_AUDIT=0 3 * * *
